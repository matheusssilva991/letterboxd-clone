# Porta HTTP publicada pelo Nginx.
HTTP_PORT=80

# Origem pública do site. Em produção, use HTTPS e seu domínio real.
APP_ORIGIN=https://letterboxd.example.com

# O navegador acessa a API pela mesma origem, através do Nginx.
NEXT_PUBLIC_API_URL=/api

# Banco de dados.
MYSQL_USER=letterboxd
MYSQL_PASSWORD=troque-por-uma-senha-forte
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-forte
MYSQL_DATABASE=letterboxd

# Cache e rate limiting.
CACHE_TTL=10
CACHE_MAX=100
THROTTLE_TTL=60000
THROTTLE_LIMIT=50

# Autenticação. Gere valores longos e aleatórios diferentes.
SECRET_KEY=gere-um-segredo-longo-e-aleatorio
EXPIRES_IN=15m
REFRESH_SECRET=gere-outro-segredo-longo-e-aleatorio
REFRESH_EXPIRES_IN=7d

# Produção deve usar migrations e manter este valor como false.
DB_SYNCHRONIZE=false

# Carga de demonstração. Preencha o token de leitura ou a API Key v3.
# O token Bearer é preferível; nunca use uma variável NEXT_PUBLIC_*.
TMDB_ACCESS_TOKEN=cole-aqui-seu-api-read-access-token
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR
TMDB_PAGES=3
SEED_MOVIE_LIMIT=50
SEED_USER_COUNT=15
SEED_REVIEW_COUNT=100
SEED_USER_PASSWORD=Demo@123
