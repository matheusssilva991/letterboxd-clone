# Dockerfile para desenvolvimento
FROM node:20-alpine

WORKDIR /usr/app

# Copiar arquivos de dependências
COPY package*.json ./

# Instalar todas as dependências
RUN npm ci

# Copiar todo o código fonte
COPY . .

# Expor a porta
EXPOSE 3001

# Modo desenvolvimento com hot reload
CMD ["npm", "run", "start:dev"]
